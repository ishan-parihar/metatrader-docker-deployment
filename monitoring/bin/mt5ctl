    for name in ['streams', 'positions', 'history', 'exposure', 'drawdown', 'risk', 'orders', 'rolling']:
        SECTION_RENDERERS[name](out)
elif SECTION in SECTION_RENDERERS:
    SECTION_RENDERERS[SECTION](out)
else:
    print(f'Unknown section: {SECTION}')
    print('Sections: streams, positions, history, exposure, drawdown, risk, orders, equity, rolling')
    sys.exit(1)

print('\\n'.join(out))

