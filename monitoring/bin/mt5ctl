# Helper: read snapshot from docker
_read_snapshot() {
    docker exec mt5-terminal cat "$SNAPSHOT_PATH" 2>/dev/null | python3 -c "
import json, sys
raw = sys.stdin.buffer.read()
if raw[:2] == b'\xff\xfe':
    text = raw[2:].decode('utf-16-le', errors='replace')
elif raw[:2] == b'\xfe\xff':
    text = raw[2:].decode('utf-16-be', errors='replace')
elif raw[:3] == b'\xef\xbb\xbf':
    text = raw[3:].decode('utf-8', errors='replace')
else:
    text = raw.decode('utf-8', errors='replace')
try:
    print(json.dumps(json.loads(text), indent=2))
except Exception as e:
    print(f'ERROR: Cannot parse snapshot: {e}', file=sys.stderr)
    sys.exit(1)
"
}

case "$cmd" in
    dashboard)
        section="${1:-all}"
        if [[ "$section" == "-json" || "$section" == "json" ]]; then
            _read_snapshot
            exit 0
        fi

        _read_snapshot | python3 -c "
import datetime as _dt
import json, sys
from collections import defaultdict

s = json.load(sys.stdin)
SECTION = '$section'

SEP = '\\u2500\\u2500'
W = 42  # section header width

# ── Strategy definitions: single source of truth (stream_defs.py, same dir) ──
# $SCRIPT_DIR is expanded by bash (this python block is double-quoted).
sys.path.insert(0, '$SCRIPT_DIR')
from stream_defs import ACCOUNT_START_BALANCE, DEPLOY_LABEL, DEPLOYED_UTC, ERA_META, GOVERNOR, LEFTOVER_CLOSES, LEGACY_STREAMS, LIVE_STREAMS, MODEL_TREES, contract_size, deploy_ts, era_label, era_of

def trade_direction(t):
    # account_snapshot history rows are closing deals (entry=1 == DEAL_ENTRY_OUT):
    # a closed BUY position emits a SELL closing deal and vice versa.
    raw = t.get('type', '?')
    return {'SELL': 'BUY', 'BUY': 'SELL'}.get(raw, raw) if t.get('entry') == 1 else raw

SWAP_TS = deploy_ts()  # v16 boundary (naive; server clock ~= UTC)
SWAP_DAY = DEPLOYED_UTC[:10]

def _parse_ts(x):
    try:
        return _dt.datetime.strptime(x, '%Y.%m.%d %H:%M:%S')
    except Exception:
        return None

def _market_closed(tstr):
    # Weekend halt window for FX/metals (server clock ~= UTC, snapshot
    # format 'YYYY-MM-DD HH:MM'): Fri from 21:00, all Sat, Sun before 22:00.
    # BTC trades weekends — its drift still surfaces via the live point.
    # Unparseable stamps (e.g. '(live)' suffix) count as open.
    try:
        d = _dt.datetime.strptime(tstr, '%Y-%m-%d %H:%M')
    except Exception:
        return False
    wd = d.weekday()  # Mon=0 .. Sun=6
    if wd == 5:
        return True
    if wd == 4 and d.hour >= 21:
        return True
    if wd == 6 and d.hour < 22:
        return True
    return False

def _agg(trades):
    # Era-pure aggregate over snapshot history rows (reconciles with the EA
    # summary when both eras are summed: v16 + legacy == inception totals).
    nets = [t.get('net', t.get('profit', 0)) for t in trades]
    n = len(nets)
    w = sum(1 for x in nets if x >= 0)
    l = n - w
    net = sum(nets)
    gw = sum(x for x in nets if x >= 0)
    gl = -sum(x for x in nets if x < 0)
    aw = gw / w if w else 0
    al = -(gl / l) if l else 0
    pf = gw / gl if gl > 0 else 0
    wr = w / n * 100.0 if n else 0
    return {'n': n, 'w': w, 'l': l, 'net': net, 'wr': wr, 'aw': aw, 'al': al, 'pf': pf}

def roi_on_margin(p, leverage):
    \"\"\"Correct ROI-on-margin for a position. Falls back to raw pnl_pct if math impossible.\"\"\"
    lots = p.get('lots', 0)
    open_px = p.get('open_price', 0)
    lev = leverage if leverage > 0 else 100
    if lots <= 0 or open_px <= 0:
        return None
    cs = contract_size(p.get('symbol', ''))
    if cs is None:  # unknown symbol: omit ROI, never guess (see stream_defs)
        return None
    margin = lots * cs * open_px / lev
    if margin <= 0:
        return None
    net = p.get('profit', 0) + p.get('swap', 0) + p.get('commission', 0)
    return net / margin * 100.0

def fmt_money(v, sign=False):
    s = f'{v:+,.2f}' if sign else f'{v:,.2f}'
    return s

def section_header(out, icon, title, count=None):
    label = f'{icon} {title}'
    if count is not None:
        label += f' ({count})'
    pad = max(0, W - len(label) - 3)
    dashes = SEP[0] * pad
    out.append(f'{SEP} {label} {SEP}{dashes}')

def section_end(out):
    pass

def governor_line():
    import subprocess, datetime as _dt, re as _re
    try:
        logf = '/config/.wine/drive_c/Program Files/MetaTrader 5/MQL5/logs/' + _dt.datetime.utcnow().strftime('%Y%m%d') + '.log'
        p = subprocess.run(
            ['docker', 'exec', 'mt5-terminal', 'sh', '-c',
             'iconv -f UTF-16LE -t UTF-8 ' + chr(39) + logf + chr(39) + ' | grep -a BookGovernor | tail -1'],
            capture_output=True, timeout=12)
        line = p.stdout.decode('utf-8', 'replace').strip()
        if p.returncode != 0 and not line:
            return '   Governor: loaded? (no trace in today log; see /charts)'
        if not line:
            return '   Governor: no trace today (check chart 10 attach)'
        m = _re.sub(r'^[A-Z]+\s+\d+\s+[0-9:.]+\s+BookGovernor [^ ]+\s+', '', line)
        fm = _re.search(r'frozen=(\d+)', m)
        pk = _re.search(r'peak=([\d.]+)', m)
        gov_ev = m[m.index('[GOV]'):].strip() if '[GOV]' in m else ''
        if fm:
            st = 'FROZEN until next month' if fm.group(1) == '1' else 'active'
            tm = _re.search(r'trail@([\d.]+)%', m)
            trail_s = tm.group(1) if tm else str(GOVERNOR['trail_pct'])
            line = '   Governor: ' + st + ' (trail@' + trail_s + ')'
            if pk:
                line += ' | peak ' + pk.group(1)
            if gov_ev:
                line += ' | last: ' + gov_ev[:90]
            return line
        return '   Governor: ' + m[:120]
    except Exception as e:
        return '   Governor: probe failed (' + str(e) + ')'

# ── Account header ──
def show_account(out):
    login = s.get('login', '?')
    server = s.get('server', '?')
    balance = s.get('balance', 0)
    equity = s.get('equity', 0)
    currency = s.get('currency', '')
    profit = s.get('profit', 0)
    margin = s.get('margin', 0)
    free_margin = s.get('free_margin', 0)
    margin_level = s.get('margin_level', 0)
    ts = s.get('ts', '?')
    peak = max(s.get('peak_equity', 0) or 0, balance, equity)
    dd = max(0.0, (peak - equity) / peak * 100.0) if peak > 0 else 0.0
    margin_util = s.get('margin_utilization', 0)

    if margin_util == 0 and equity > 0:
        margin_util = margin / equity * 100.0

    out.append(f'\\U0001f4b0 {login} @ {server}')
    out.append(f'   Balance {fmt_money(balance)} {currency} \\u2502 Equity {fmt_money(equity)} \\u2502 PnL {fmt_money(profit, True)}')
    if margin_level > 0:
        margin_status = '\\u2705' if margin_level > 1000 else ('\\u26a0\\ufe0f' if margin_level > 200 else '\\U0001f534')
        lvl_s = f'\\u2502 Lvl {margin_level:.0f}% {margin_status}'
    else:
        lvl_s = ''
    out.append(f'   Margin {fmt_money(margin)} \\u2502 Free {fmt_money(free_margin)} \\u2502 Util {margin_util:.1f}% {lvl_s}'.rstrip(' \\u2502'))
    if peak > 0:
        dd_amt = peak - equity
        out.append(f'   Peak {fmt_money(peak)} \\u2502 DD {dd:.2f}% ({fmt_money(dd_amt)} from peak)')
    gov_trail = GOVERNOR['trail_pct']
    n_streams = len(LIVE_STREAMS)
    out.append(f'   Model {MODEL_TREES} trees ({DEPLOY_LABEL}) \\u2502 {n_streams} streams + BookGovernor (T4 trail@{gov_trail}%)')


def render_positions(out):
    positions = s.get('positions', [])
    summary = s.get('position_summary', {})
    leverage = s.get('leverage', 0)
    section_header(out, '\\U0001f4ca', 'Open Positions', len(positions))

    total_pnl = summary.get('total_pnl', 0)
    total_swap = summary.get('total_swap', 0)
    total_comm = summary.get('total_commission', 0)
    total_net = summary.get('total_net', 0)

    if total_pnl == 0 and total_net == 0 and positions:
        total_pnl = sum(p.get('profit', 0) for p in positions)
        total_swap = sum(p.get('swap', 0) for p in positions)
        total_comm = sum(p.get('commission', 0) for p in positions)
        total_net = total_pnl + total_swap + total_comm

    out.append(f'   Total \\u2502 PnL {fmt_money(total_pnl, True)} \\u2502 Swap {fmt_money(total_swap, True)} \\u2502 Comm {fmt_money(total_comm, True)} \\u2502 Net {fmt_money(total_net, True)}')
    section_end(out)

    if not positions:
        out.append('   No open positions')
        section_end(out)
        return

    for i, p in enumerate(positions):
        pnl = p['profit']
        swap = p.get('swap', 0)
        comm = p.get('commission', 0)
        net = pnl + swap + comm
        entry = p.get('open_price', 0)
        cur = p.get('current_price', 0)
        sl = p.get('sl', 0)
        tp = p.get('tp', 0)
        risk = p.get('risk_pct', 0)
        hold = p.get('hold_bars', 0)
        open_time = p.get('open_time', '')

        # ROI on margin computed locally (EA's pnl_pct field is unreliable — contract size bug)
        roi = roi_on_margin(p, leverage)

        # STRUCTURAL R:R — planned reward:risk at entry. NEVER use the EA's rr_ratio field:
        # it computes |tp-current|/|current-sl| which explodes as price approaches the stop.
        # The structural ratio is fixed for the life of the trade.
        rr_struct = None
        if entry > 0 and sl > 0 and tp > 0:
            denom = abs(entry - sl)
            if denom > 0:
                rr_struct = abs(tp - entry) / denom
        rr_s = f'1:{rr_struct:.1f}' if rr_struct else '\u2014'

        # LIVE SL gap — distance from current price to stop. This one SHOULD move with price.
        gap_s = '\u2014'
        warn = ''
        if cur > 0 and sl > 0:
            gap = abs(cur - sl)
            gap_s = f'{gap:.5f}'
            entry_sl = abs(entry - sl) if entry > 0 else 0
            if entry_sl > 0 and gap / entry_sl < 0.25:
                warn = ' \u26a0\ufe0f NEAR SL'
            elif pnl < 0 and entry_sl > 0 and gap < entry_sl * 0.5:
                warn = ' \U0001f7e1 losing'

        sl_s = f'{sl:.5f}' if sl > 0 else '\u2014'
        tp_s = f'{tp:.5f}' if tp > 0 else '\u2014'
        risk_s = f'{risk:.1f}%' if risk > 0 else '\u2014'
        hold_s = f'{hold}' if hold > 0 else '\u2014'
        since_s = open_time if open_time else '\u2014'
        cur_s = f'{cur:.5f}' if cur > 0 else '\u2014'

        out.append(f'   {p[\"type\"]} {p[\"symbol\"]} {p[\"lots\"]} lots @ {entry:.5f} \\u2192 now {cur_s}{warn}')
        pnl_line = f'     PnL {fmt_money(pnl, True)}'
        if roi is not None and abs(roi) < 100000:
            pnl_line += f' ({roi:+.1f}%)'
        pnl_line += f' \u2502 Net {fmt_money(net, True)} \u2502 SL {sl_s} \u2502 TP {tp_s}'
        out.append(pnl_line)
        out.append(f'     Risk {risk_s} \u2502 R:R {rr_s} (structural) \u2502 SL gap {gap_s} \u2502 Held {hold_s} bars')
        out.append(f'     Since {since_s}')
        if i < len(positions) - 1:
            out.append('   \u00b7\u00b7\u00b7')
    section_end(out)


def _per_rows(per):
    # Shared per-strategy row renderer. Latest activity first (last desc,
    # net desc tiebreak) — the most recent story reads first, always.
    lines = []
    for lab, d in sorted(per.items(), key=lambda kv: (kv[1]['last'], kv[1]['net']), reverse=True):
        n_ = d['n']; w_ = d['w']; net_ = fmt_money(d['net'], True); last_ = d['last'][:10]
        lines.append(f'     {lab:22s} {n_:3d} trades {w_:2d}W/{n_-w_:2d}L \\u2502 net {net_:>10s} \\u2502 last {last_}')
    return lines

def _fold_line(out, tag, window, g, extra=''):
    # One fold-comparison line: trades, W/L, net, PF. No v16-book mixing.
    n = g['n']; w = g['w']; l = g['l']
    net = fmt_money(g['net'], True); pf = g['pf']
    out.append(f'   {tag} ({window}): {n} trades {w}W/{l}L \\u2502 net {net} \\u2502 PF {pf:.2f}{extra}')

def render_history(out):
    history = s.get('history', [])
    # Era segregation: the book a trade belongs to is decided by close time
    # (leftover tickets: by open era), never by magic alone — magics were
    # recycled across all four eras. Unknown-time rows join v16 (current book).
    by_era = {}
    for t in history:
        e = era_of(t.get('time', ''), t.get('ticket'))
        if e == 'unknown':
            e = 'v16'
        by_era.setdefault(e, []).append(t)
    v16 = by_era.get('v16', [])
    a = _agg(v16)
    an = a['n']; aw = a['w']; al = a['l']; awr = a['wr']

    section_header(out, '\\U0001f4cb', 'Closed Trades — v16 book', f'{an} trades since {SWAP_DAY}, {aw}W/{al}L, {awr:.0f}% WR')

    if an > 0:
        anet = fmt_money(a['net'], True); aaw = fmt_money(a['aw'], True); aal = fmt_money(a['al'], True); apf = a['pf']
        out.append(f'   Net {anet} \\u2502 Avg Win {aaw} \\u2502 Avg Loss {aal} \\u2502 PF {apf:.2f}')
    else:
        out.append('   No v16 trades yet (book is live, no closes)')
    # Fold comparison: per-model aggregates. v16 + P1 + P2 + P3 reconcile
    # exactly with the EA inception totals (reconciliation guard below).
    p1 = _agg(by_era.get('legacy-p1-141', []))
    p2 = _agg(by_era.get('legacy-p2-231', []))
    p3 = _agg(by_era.get('legacy-p3-101', []))
    # Balance-curve trough (dynamic; shown only if the full-window
    # reconstruction reconciles with the live balance to within 1 USC).
    trough_s = ''
    ordered = sorted(history, key=lambda t: _parse_ts(t.get('time', '')) or _dt.datetime.min)
    bal = ACCOUNT_START_BALANCE; tmin = bal; tmin_t = ''
    for t in ordered:
        bal += t.get('net', t.get('profit', 0))
        if bal < tmin:
            tmin = bal; tmin_t = t.get('time', '')[:10]
    if ordered and abs(bal - s.get('balance', 0)) < 1.0 and tmin_t:
        tmin_s = fmt_money(tmin)
        trough_s = f' \\u2502 trough {tmin_s} @ {tmin_t}'
    m1 = ERA_META['legacy-p1-141']
    _fold_line(out, m1['tag'], m1['window'], p1, trough_s)
    m2 = ERA_META['legacy-p2-231']
    _fold_line(out, m2['tag'], m2['window'], p2)
    m3 = ERA_META['legacy-p3-101']
    _fold_line(out, m3['tag'], m3['window'], p3)

    if history:
        # Chronological integrity: sort explicitly by parsed close time, newest first.
        # The EA iterates the deal pool by index; MT5 does NOT guarantee index order
        # matches time order (batches/tickets can scramble it).
        history_sorted = sorted(history, key=lambda t: _parse_ts(t.get('time', '')) or _dt.datetime.min, reverse=True)

        show_n = min(15, len(history_sorted))
        section_end(out)
        out.append(f'   Recently closed (newest first, last {show_n}; fold tags in brackets):')
        for t in history_sorted[:show_n]:
            net = t.get('net', t.get('profit', 0))
            sign = '+' if net >= 0 else ''
            icon = '\\u2705' if net >= 0 else '\\u274c'
            t_time = t.get('time', '?')
            t_type = trade_direction(t)
            t_sym = t.get('symbol', '?')
            t_lots = t.get('lots', 0)
            t_magic = era_label(t.get('magic', '?'), t.get('time', ''), t.get('ticket'))
            out.append(f'     {t_time} \\u2502 {icon} {sign}{net:.2f} \\u2502 {t_type} {t_sym} {t_lots} \\u2502 {t_magic}')
        section_end(out)
        # per-strategy aggregation, grouped by fold
        pers = {}
        for t in history:
            e = era_of(t.get('time', ''), t.get('ticket'))
            if e == 'unknown':
                e = 'v16'
            lab = era_label(t.get('magic', '?'), t.get('time', ''), t.get('ticket'))
            per = pers.setdefault(e, {})
            d = per.setdefault(lab, {'n': 0, 'w': 0, 'net': 0.0, 'last': ''})
            net = t.get('net', t.get('profit', 0))
            d['n'] += 1; d['net'] += net
            if net >= 0: d['w'] += 1
            ti = t.get('time', '')
            if ti > d['last']: d['last'] = ti
        section_end(out)
        for e in ('v16', 'legacy-p1-141', 'legacy-p2-231', 'legacy-p3-101'):
            meta = ERA_META[e]
            ptag = meta['tag']
            out.append(f'   Per-strategy — {ptag}:')
            rows = _per_rows(pers.get(e, {}))
            out.extend(rows if rows else ['     (no trades)'])
    section_end(out)



def render_exposure(out):
    positions = s.get('positions', [])
    sym_data = defaultdict(lambda: {'lots': 0.0, 'pnl': 0.0, 'count': 0, 'swap': 0.0, 'comm': 0.0})
    mag_data = defaultdict(lambda: {'lots': 0.0, 'pnl': 0.0, 'count': 0, 'swap': 0.0, 'comm': 0.0})

    for p in positions:
        sym = p.get('symbol', '?')
        magic = str(p.get('magic', '?'))
        lots = p.get('lots', 0)
        pnl = p.get('profit', 0)
        swap = p.get('swap', 0)
        comm = p.get('commission', 0)

        sym_data[sym]['lots'] += lots
        sym_data[sym]['pnl'] += pnl
        sym_data[sym]['swap'] += swap
        sym_data[sym]['comm'] += comm
        sym_data[sym]['count'] += 1

        mag_data[magic]['lots'] += lots
        mag_data[magic]['pnl'] += pnl
        mag_data[magic]['swap'] += swap
        mag_data[magic]['comm'] += comm
        mag_data[magic]['count'] += 1

    for item in s.get('symbol_exposure', []):
        sym = item.get('symbol', '?')
        if sym not in sym_data:
            sym_data[sym] = {'lots': item.get('lots',0), 'pnl': item.get('pnl',0), 'count': item.get('count',0), 'swap': 0, 'comm': 0}

    for item in s.get('strategy_performance', []):
        magic = str(item.get('magic', '?'))
        if magic not in mag_data:
            mag_data[magic] = {'lots': item.get('lots',0), 'pnl': item.get('pnl',0), 'count': item.get('count',0), 'swap': 0, 'comm': 0}

    section_header(out, '\\U0001f3af', 'Exposure', f'{len(positions)} positions')

    if not sym_data:
        out.append('   No open positions')
        section_end(out)
        return

    total_lots = sum(x['lots'] for x in sym_data.values())
    total_pnl = sum(x['pnl'] for x in sym_data.values())
    total_swap = sum(x['swap'] for x in sym_data.values())
    total_comm = sum(x['comm'] for x in sym_data.values())
    total_net = total_pnl + total_swap + total_comm

    out.append(f'   Total \\u2502 {total_lots:.2f} lots \\u2502 PnL {fmt_money(total_pnl, True)} \\u2502 Net {fmt_money(total_net, True)}')
    section_end(out)

    out.append('   By Symbol:')
    for sym, d in sorted(sym_data.items(), key=lambda a: abs(a[1]['pnl']), reverse=True):
        pnl = d['pnl']
        net = pnl + d['swap'] + d['comm']
        pct = d['lots'] / total_lots * 100 if total_lots > 0 else 0
        out.append(f'     {sym:12s} {d[\"lots\"]:5.2f} lots ({pct:4.1f}%) \\u2502 PnL {fmt_money(pnl, True)} \\u2502 Net {fmt_money(net, True)}')

    if mag_data:
        section_end(out)
        out.append('   By Strategy:')
        for magic, d in sorted(mag_data.items(), key=lambda a: abs(a[1]['pnl']), reverse=True):
            pnl = d['pnl']
            net = pnl + d['swap'] + d['comm']
            out.append(f'     {magic:>10s} \\u2502 {d[\"lots\"]:5.2f} lots \\u2502 PnL {fmt_money(pnl, True)} \\u2502 Net {fmt_money(net, True)}')

    section_end(out)
    out.append('   Per-Position:')
    for p in positions:
        pnl = p.get('profit', 0)
        swap = p.get('swap', 0)
        comm = p.get('commission', 0)
        net = pnl + swap + comm
        magic = p.get('magic', '?')
        out.append(f'     #{p[\"ticket\"]} {p[\"type\"]} {p[\"symbol\"]} {p[\"lots\"]} lots \\u2502 PnL {fmt_money(pnl, True)} \\u2502 Net {fmt_money(net, True)} \\u2502 {magic}')
    section_end(out)


def compute_drawdown():
    \"\"\"Drawdown with sane floor: peak >= balance & equity; clamped to >= 0.\"\"\"
    balance = s.get('balance', 0)
    equity = s.get('equity', 0)
    peak = max(s.get('peak_equity', 0) or 0, balance, equity)
    dd = max(0.0, (peak - equity) / peak * 100.0) if peak > 0 else 0.0
    return balance, equity, peak, dd


def render_drawdown(out):
    balance, equity, peak, dd = compute_drawdown()

    section_header(out, '\\U0001f4c9', 'Drawdown')
    dd_amount = peak - equity
    out.append(f'   Balance {fmt_money(balance)} \\u2502 Equity {fmt_money(equity)} \\u2502 Peak {fmt_money(peak)}')
    out.append(f'   Drawdown {dd:.2f}% \\u2502 {fmt_money(dd_amount)} from peak')

    bar_len = min(int(dd / 100 * 40), 40)
    bar = '\\u2588' * bar_len + '\\u2591' * (40 - bar_len)
    out.append(f'   [{bar}] {dd:.1f}%')
    section_end(out)

    snapshots = list(s.get('equity_snapshots', []))
    live_eq = s.get('equity', 0)
    # Drop closed-market hours: the EA snapshots around the clock, but
    # hourly DD points are meaningless while FX/metals are halted.
    hidden = 0
    visible = []
    for x in snapshots:
        if _market_closed(x.get('time', '')):
            hidden += 1
        else:
            visible.append(x)
    snapshots = visible
    if snapshots:
        last = snapshots[-1]
        last_eq = last.get('equity', 0)
        # Append the live equity point when it differs from the last hourly snapshot
        if abs(last_eq - live_eq) > 0.005:
            sts = s.get('ts', 'now')
            snapshots.append({'time': f'{sts} (live)', 'equity': live_eq})
        n_sn = len(snapshots)
        pt = 'points' if n_sn != 1 else 'point'
        hid = ''
        if hidden > 0:
            hid = f' (+{hidden} weekend hidden)'
        out.append(f'   Equity Curve ({n_sn} {pt}){hid}:')
        min_eq = min(x['equity'] for x in snapshots)
        max_eq = max(x['equity'] for x in snapshots)
        rng = max_eq - min_eq if max_eq != min_eq else 1
        for x in snapshots:
            eq = x['equity']
            bar_len = int(round((eq - min_eq) / rng * 20))
            bar_len = max(0, min(bar_len, 20))
            bar = '\\u2588' * bar_len + '\\u2591' * (20 - bar_len)
            out.append(f'   {x[\"time\"]} \\u2502 {bar} {eq:.2f}')
    else:
        if hidden > 0:
            out.append(f'   No open-market snapshots in window ({hidden} weekend points hidden)')
        else:
            out.append('   No equity snapshots yet (EA collects hourly)')
        if live_eq > 0:
            out.append(f'   Live equity: {live_eq:.2f}')
    section_end(out)


def render_risk(out):
    equity = s.get('equity', 0)
    margin = s.get('margin', 0)
    free_margin = s.get('free_margin', 0)
    margin_level = s.get('margin_level', 0)
    margin_util = s.get('margin_utilization', 0)

    if margin_util == 0 and equity > 0:
        margin_util = margin / equity * 100.0

    section_header(out, '\\u26a0\\ufe0f', 'Risk')
    if margin_level > 0:
        status = '\\u2705 Healthy' if margin_level > 1000 else ('\\u26a0\\ufe0f Warning' if margin_level > 200 else ('\\U0001f7e0 Danger' if margin_level > 100 else '\\U0001f534 CRITICAL'))
        lvl_s = f'\\u2502 Level {margin_level:.0f}% \\u2502 {status}'
    else:
        status = '\\U0001f534 CRITICAL' if margin > 0 else '\\u2705 No exposure'
        lvl_s = f'\\u2502 Level n/a \\u2502 {status}'
    out.append(f'   Equity {fmt_money(equity)} \\u2502 Margin {fmt_money(margin)} \\u2502 Free {fmt_money(free_margin)}')
    out.append(f'   Utilization {margin_util:.1f}% {lvl_s}')
    section_end(out)

    positions = s.get('positions', [])
    if positions:
        leverage = s.get('leverage', 0)
        out.append('   Per-Position Risk:')
        for i, p in enumerate(positions):
            risk = p.get('risk_pct', 0)
            sl = p.get('sl', 0)
            tp = p.get('tp', 0)
            entry = p.get('open_price', 0)
            hold = p.get('hold_bars', 0)
            cur_px = p.get('current_price', 0)

            # Structural R:R from ENTRY prices (never the EA's dynamic rr_ratio)
            rr_struct = None
            if entry > 0 and sl > 0 and tp > 0:
                denom = abs(entry - sl)
                if denom > 0:
                    rr_struct = abs(tp - entry) / denom

            # Live SL gap
            sl_gap = abs(cur_px - sl) if cur_px > 0 and sl > 0 else 0

            # Fallback risk calc uses LIVE SL gap (money at risk right now),
            # with contract size correction.
            live_sl_dist = sl_gap or abs(entry - sl)
            if risk == 0 and live_sl_dist > 0 and equity > 0:
                cs = contract_size(p.get('symbol', ''))
                if cs is not None:  # unknown symbol: leave risk unknown, never guess
                    risk = live_sl_dist * cs * p.get('lots', 0) / equity * 100.0

            gap_s = f'{sl_gap:.5f}' if sl > 0 else '\u2014'
            risk_s = f'{risk:.2f}%' if risk > 0 else '\u2014'
            rr_s = f'1:{rr_struct:.1f}' if rr_struct else '\u2014'
            hold_s = f'{hold}' if hold > 0 else '\u2014'
            cur_s = f'{cur_px:.5f}' if cur_px > 0 else '\u2014'
            pnl = p.get('profit', 0)

            warn = ''
            if entry > 0 and sl > 0 and cur_px > 0:
                entry_sl = abs(entry - sl)
                if entry_sl > 0 and sl_gap / entry_sl < 0.25:
                    warn = ' \u26a0\ufe0f NEAR SL'

            out.append(f'     {p[\"type\"]} {p[\"symbol\"]} {p[\"lots\"]} lots \\u2502 now {cur_s}{warn}')
            out.append(f'       Risk {risk_s} \\u2502 R:R {rr_s} (structural) \\u2502 SL gap {gap_s} \\u2502 Held {hold_s} bars')
            out.append(f'       PnL {fmt_money(pnl, True)}')
            if i < len(positions) - 1:
                out.append('       \u00b7\u00b7\u00b7')
    section_end(out)


def render_orders(out):
    orders = s.get('pending_orders', [])
    section_header(out, '\\U0001f4cb', 'Pending Orders', len(orders))
    if not orders:
        out.append('   None')
    else:
        for o in sorted(orders, key=lambda o: o.get('time', ''), reverse=True):
            sl = o.get('sl', 0)
            tp = o.get('tp', 0)
            sl_s = f'{sl:.5f}' if sl > 0 else '\\u2014'
            tp_s = f'{tp:.5f}' if tp > 0 else '\\u2014'
            out.append(f'   #{o[\"ticket\"]} {o[\"type\"]} {o[\"symbol\"]} {o[\"lots\"]} lots @ {o[\"price\"]:.5f}')
            out.append(f'     SL {sl_s} \\u2502 TP {tp_s} \\u2502 {o.get(\"time\",\"?\")}')
    section_end(out)


def render_equity(out):
    render_drawdown(out)


def _wl_disp(w, l, trades):
    # Compact W/L display shared by rolling headline + fold sub-lines.
    if trades == 0:
        return 'no trades'
    if w == 0:
        return f'{l}L'
    if l == 0:
        return f'{w}W'
    return f'{w}W/{l}L'

def render_rolling(out):
    # Window PnL computed from deal history (close time), split by deployment
    # fold — headline == sum of folds, newest fold first. Windows: UTC day /
    # trailing 7d / trailing 30d.
    history = s.get('history', [])
    now = _dt.datetime.utcnow()
    parsed = [(t, _parse_ts(t.get('time', ''))) for t in history]
    section_header(out, '\U0001f4c8', 'Rolling PnL')
    ROLL_INDENT = '                         '  # 25 spaces — aligns with main line │
    FOLD_ORDER = ('v16', 'legacy-p3-101', 'legacy-p2-231', 'legacy-p1-141')
    for label, span in [('Today', 1), ('Week', 7), ('Month', 30)]:
        if span == 1:
            wtrades = [t for t, ts in parsed if ts and ts.date() == now.date()]
        else:
            cut = now - _dt.timedelta(days=span)
            wtrades = [t for t, ts in parsed if ts and ts >= cut]
        a = _agg(wtrades)
        trades = a['n']; w = a['w']; l = a['l']
        anet = a['net']; awr = a['wr']; aaw = a['aw']; aal = a['al']
        wl = _wl_disp(w, l, trades)
        if trades > 0 and w > 0 and l > 0:
            avg_s = f'avg {fmt_money(aaw, True)} / {fmt_money(aal)}'
        elif trades > 0 and l > 0:
            avg_s = f'avg loss {fmt_money(aal)}'
        elif trades > 0 and w > 0:
            avg_s = f'avg win {fmt_money(aaw, True)}'
        else:
            avg_s = ''
        trade_s = f'{trades} trade' + ('s' if trades != 1 else '')
        out.append(f'   {label:8s} {fmt_money(anet, True):>12s} \u2502 {trade_s} \u2502 {wl} \u2502 {awr:.0f}% WR')
        if avg_s:
            out.append(f'{ROLL_INDENT}\u2502 {avg_s}')
        by_era = {}
        for t in wtrades:
            e = era_of(t.get('time', ''), t.get('ticket'))
            if e == 'unknown':
                e = 'v16'
            by_era.setdefault(e, []).append(t)
        for e in FOLD_ORDER:
            g = by_era.get(e)
            if not g:
                continue
            ga = _agg(g)
            gn = ga['n']
            gnet = ga['net']
            etag = ERA_META[e]['tag']
            gwl = _wl_disp(ga['w'], ga['l'], gn)
            gtrade_s = f'{gn} trade' + ('s' if gn != 1 else '')
            out.append(f'{ROLL_INDENT}\u2502 {etag}: {fmt_money(gnet, True)} \u2502 {gtrade_s} \u2502 {gwl}')
    section_end(out)


def render_streams(out):
    now = _dt.datetime.utcnow()
    w7 = now - _dt.timedelta(days=7)
    w30 = now - _dt.timedelta(days=30)
    history = s.get('history', [])
    positions = s.get('positions', [])
    open_magics = {}
    for p in positions:
        m = str(p.get('magic', '?'))
        open_magics[m] = open_magics.get(m, 0) + 1
    # Era segregation: only v16-era trades count toward live streams.
    # Legacy trades roll into per-fold book lines (recycled magics).
    per = {}
    folds = {'legacy-p1-141': [0, 0, 0.0], 'legacy-p2-231': [0, 0, 0.0],
             'legacy-p3-101': [0, 0, 0.0]}  # [n, wins, net]
    leg_man = [0, 0, 0.0]  # legacy-era manual/aux (non-book magics)
    for t in history:
        m = str(t.get('magic', '?'))
        ts = _parse_ts(t.get('time', ''))
        net = t.get('net', t.get('profit', 0))
        e = era_of(t.get('time', ''), t.get('ticket'))
        if e != 'v16' and e != 'unknown':
            try:
                mi = int(t.get('magic', -1))
            except Exception:
                mi = -1
            try:
                leftover = int(t.get('ticket', -1)) in LEFTOVER_CLOSES
            except Exception:
                leftover = False
            dest = folds[e] if (mi in LEGACY_STREAMS or leftover) else leg_man
            dest[0] += 1; dest[2] += net
            if net >= 0: dest[1] += 1
            continue
        d = per.setdefault(m, {'n7': 0, 'p7': 0.0, 'n30': 0, 'p30': 0.0, 'last': ''})
        if ts and ts >= w7:
            d['n7'] += 1; d['p7'] += net
        if ts and ts >= w30:
            d['n30'] += 1; d['p30'] += net
        if ts and ts.strftime('%m-%d') > d['last']:
            d['last'] = ts.strftime('%m-%d')
    section_header(out, '\u2699\ufe0f',
                   f'Streams ({len(LIVE_STREAMS)} live + governor)')
    # Latest-first: open streams float to the top, then most-recently-traded.
    # Stable sort — idle/never-traded streams keep book order.
    by_last = sorted(LIVE_STREAMS, key=lambda mg: per.get(str(mg), {}).get('last', ''), reverse=True)
    ordered = sorted(by_last, key=lambda mg: 0 if str(mg) in open_magics else 1)
    for magic in ordered:
        sdef = LIVE_STREAMS[magic]
        label, sym, tf = sdef['label'], sdef['symbol'], sdef['tf']
        m = str(magic)
        d = per.get(m, {'n7': 0, 'p7': 0.0, 'n30': 0, 'p30': 0.0, 'last': ''})
        st = 'open ' + str(open_magics[m]) if m in open_magics else 'idle'
        n7 = d['n7']; p7 = fmt_money(d['p7'], True)
        n30 = d['n30']; p30 = fmt_money(d['p30'], True)
        last = d['last'] or '—'
        out.append('   ' + f'{label:16s} {st:8s} last {last:5s} \\u2502 7d {n7:2d}t {p7:>9s} \\u2502 30d {n30:2d}t {p30:>9s}')
    for e in ('legacy-p1-141', 'legacy-p2-231', 'legacy-p3-101'):
        meta = ERA_META[e]
        fn = folds[e][0]; fw = folds[e][1]; fnet = fmt_money(folds[e][2], True)
        ftag = meta['tag']; fwin = meta['window']
        out.append(f'   {ftag} ({fwin}): {fn} trades {fw}W/{fn-fw}L \\u2502 net {fnet}')
    if leg_man[0] > 0:
        mnet = fmt_money(leg_man[2], True)
        out.append(f'   Legacy manual/aux: {leg_man[0]} trades {leg_man[1]}W/{leg_man[0]-leg_man[1]}L \\u2502 net {mnet}')
    out.append(governor_line())
    section_end(out)


# ── Render ──
SECTION_RENDERERS = {
    'streams': render_streams,
    'positions': render_positions,
    'history': render_history,
    'exposure': render_exposure,
    'drawdown': render_drawdown,
    'risk': render_risk,
    'orders': render_orders,
    'equity': render_equity,
    'rolling': render_rolling,
}

out = []
show_account(out)

# Reading order: current state first (positions → pending → exposure →
# risk → drawdown), then recent performance (rolling by fold), then book
# detail (streams) and the full audit trail (history) last.
if SECTION == 'all':
    for name in ['positions', 'orders', 'exposure', 'risk', 'drawdown', 'rolling', 'streams', 'history']:
        SECTION_RENDERERS[name](out)
elif SECTION in SECTION_RENDERERS:
    SECTION_RENDERERS[SECTION](out)
else:
    print(f'Unknown section: {SECTION}')
    print('Sections: positions, orders, exposure, risk, drawdown, rolling, streams, history, equity')
    sys.exit(1)

print('\\n'.join(out))

