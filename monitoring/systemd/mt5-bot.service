[Unit]
Description=MT5 Monitoring Telegram Bot Handler
Documentation=file:///home/ishanp/mt5-deploy/logcheck/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ishanp
WorkingDirectory=/home/ishanp/mt5-deploy/logcheck
ExecStart=/usr/bin/python3 /home/ishanp/mt5-deploy/logcheck/bin/mt5_bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ishanp/mt5-deploy/logcheck/state/bot.log
StandardError=append:/home/ishanp/mt5-deploy/logcheck/state/bot.log

[Install]
WantedBy=multi-user.target
