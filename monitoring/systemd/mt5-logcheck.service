[Unit]
Description=MT5 Monitoring Weekly Log Check
Documentation=file:///home/ishanp/mt5-deploy/logcheck/README.md

[Service]
Type=oneshot
User=ishanp
WorkingDirectory=/home/ishanp/mt5-deploy/logcheck
ExecStart=/home/ishanp/mt5-deploy/logcheck/bin/mt5_logcheck.sh --days 7
StandardOutput=append:/home/ishanp/mt5-deploy/logcheck/state/logcheck.log
StandardError=append:/home/ishanp/mt5-deploy/logcheck/state/logcheck.log
